<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- StackPane container allows overlaying dialog.fxml modally -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.ProfileController">
    <children>

        <!-- MAIN DASHBOARD CONTENT -->
        <ScrollPane fitToWidth="true" styleClass="table-scroll">
            <stylesheets>
                <URL value="@aniplato.css" />
            </stylesheets>
            <content>
                <VBox spacing="20.0" styleClass="dashboard-bg">
                    <stylesheets>
                        <!-- Use @aniplato.css for files sitting directly inside view/ -->
                        <URL value="@aniplato.css" />
                    </stylesheets>
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
                    </padding>
                    <children>

                        <Label styleClass="page-title" text="Profile" />

                        <!-- PATTERN:DYNAMIC visibility: docAlertBanner shown when documents are expiring or expired -->
                        <HBox fx:id="docAlertBanner" managed="false" styleClass="notice-box" visible="false">
                            <padding>
                                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                            </padding>
                            <children>
                                <!-- PATTERN:DYNAMIC docAlertText : warning summary -->
                                <Label fx:id="docAlertTextLabel" styleClass="form-label" text="" />
                            </children>
                        </HBox>

                        <!-- =================================================================== -->
                        <!-- 1. ADMIN ACCOUNT CARD (Shown for ADMIN role)                        -->
                        <!-- =================================================================== -->
                        <!-- PATTERN:DYNAMIC visibility: adminCardBox shown for Admin role (default) -->
                        <VBox fx:id="adminCardBox" spacing="16.0" styleClass="table-card">
                            <padding>
                                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                            </padding>
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="section-title" text="Admin account" />
                                        <Label styleClass="text-muted" text="Admins don't have organization documents." />
                                    </children>
                                </VBox>

                                <GridPane hgap="16.0" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="35.0" />
                                        <ColumnConstraints percentWidth="35.0" />
                                        <ColumnConstraints percentWidth="30.0" />
                                    </columnConstraints>
                                    <children>
                                        <!-- NAME -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0">
                                            <children>
                                                <Label styleClass="stat-card-title" text="NAME" />
                                                <!-- PATTERN:DYNAMIC adminName : admin full name -->
                                                <Label fx:id="adminNameLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>

                                        <!-- ROLE -->
                                        <VBox spacing="6.0" GridPane.columnIndex="1">
                                            <children>
                                                <Label styleClass="stat-card-title" text="ROLE" />
                                                <!-- PATTERN:DYNAMIC adminRole : "Admin" -->
                                                <Label fx:id="adminRoleLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>

                                        <!-- SINCE -->
                                        <VBox spacing="6.0" GridPane.columnIndex="2">
                                            <children>
                                                <Label styleClass="stat-card-title" text="SINCE" />
                                                <!-- PATTERN:DYNAMIC adminSince : registration date -->
                                                <Label fx:id="adminSinceLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <!-- =================================================================== -->
                        <!-- 2. ORGANIZATION CARD (Shown for DONOR and FOOD_GROUP roles)        -->
                        <!-- =================================================================== -->
                        <!-- PATTERN:DYNAMIC visibility: orgCardBox shown for organization roles -->
                        <VBox fx:id="orgCardBox" managed="false" spacing="16.0" styleClass="table-card" visible="false">
                            <padding>
                                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                            </padding>
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="section-title" text="Organization" />
                                        <Label styleClass="text-muted" text="Name, type and city: contact the admin, since changes need your documents checked again." />
                                    </children>
                                </VBox>

                                <GridPane hgap="16.0" vgap="16.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="35.0" />
                                        <ColumnConstraints percentWidth="35.0" />
                                        <ColumnConstraints percentWidth="30.0" />
                                    </columnConstraints>
                                    <children>
                                        <!-- ROW 1 -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="stat-card-title" text="NAME" />
                                                <!-- PATTERN:DYNAMIC orgName : organization name -->
                                                <Label fx:id="orgNameLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="stat-card-title" text="ROLE" />
                                                <!-- PATTERN:DYNAMIC orgRole : role title -->
                                                <Label fx:id="orgRoleLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="stat-card-title" text="EMAIL" />
                                                <!-- PATTERN:DYNAMIC orgType : organization contact email (the schema has no organization type) -->
                                                <Label fx:id="orgTypeLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>

                                        <!-- ROW 2 -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <children>
                                                <Label styleClass="stat-card-title" text="CITY" />
                                                <!-- PATTERN:DYNAMIC orgCity : city name -->
                                                <Label fx:id="orgCityLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Label styleClass="stat-card-title" text="CONTACT PERSON" />
                                                <!-- PATTERN:DYNAMIC orgContact : contact person name & phone -->
                                                <Label fx:id="orgContactLabel" styleClass="form-label" text="" />
                                                <!-- PATTERN:ACTION handleEditContact -->
                                                <Hyperlink onAction="#handleEditContact" styleClass="terms-link" text="Edit" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                            <children>
                                                <Label styleClass="stat-card-title" text="APPROVED" />
                                                <!-- PATTERN:DYNAMIC orgApprovedDate : approval date -->
                                                <Label fx:id="orgApprovedDateLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <!-- =================================================================== -->
                        <!-- 3. DOCUMENTS CARD (Shown for DONOR and FOOD_GROUP roles)           -->
                        <!-- =================================================================== -->
                        <!-- PATTERN:DYNAMIC visibility: docsCardBox shown for organization roles -->
                        <VBox fx:id="docsCardBox" managed="false" spacing="16.0" styleClass="table-card" visible="false">
                            <padding>
                                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                            </padding>
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="section-title" text="Documents" />
                                        <Label styleClass="text-muted" text="Keep these current. An expired document suspends your account until a renewal is verified." />
                                    </children>
                                </VBox>

                                <!-- DOCUMENTS TABLE GRID -->
                                <VBox spacing="0.0">
                                    <children>
                                        <!-- HEADER ROW -->
                                        <GridPane styleClass="table-header-row">
                                            <padding>
                                                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
                                            </padding>
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="28.0" />
                                                <ColumnConstraints percentWidth="26.0" />
                                                <ColumnConstraints percentWidth="18.0" />
                                                <ColumnConstraints percentWidth="28.0" />
                                            </columnConstraints>
                                            <children>
                                                <Label styleClass="table-header-text" text="DOCUMENT" GridPane.columnIndex="0" />
                                                <Label styleClass="table-header-text" text="FILE" GridPane.columnIndex="1" />
                                                <Label styleClass="table-header-text" text="EXPIRES" GridPane.columnIndex="2" />
                                                <Label styleClass="table-header-text" text="STATUS" GridPane.columnIndex="3" />
                                            </children>
                                        </GridPane>

                                        <!-- PATTERN:LIST docRowsBox : list of required documents for this organization -->
                                        <VBox fx:id="docRowsBox">
                                            <children>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- =================================================================== -->
                        <!-- 4. ACCOUNT LOGIN & PASSWORD CARD (Common for ALL roles)           -->
                        <!-- =================================================================== -->
                        <VBox spacing="16.0" styleClass="table-card">
                            <padding>
                                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                            </padding>
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="section-title" text="Account" />
                                        <Label styleClass="text-muted" text="Your login for the ANIPLATO app." />
                                    </children>
                                </VBox>

                                <GridPane hgap="16.0" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <!-- LOGIN EMAIL -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0">
                                            <children>
                                                <Label styleClass="stat-card-title" text="LOGIN EMAIL" />
                                                <!-- PATTERN:DYNAMIC loginEmail : user login email -->
                                                <Label fx:id="loginEmailLabel" styleClass="form-label" text="" />
                                            </children>
                                        </VBox>

                                        <!-- PASSWORD & ACTION BUTTONS -->
                                        <HBox alignment="CENTER_LEFT" spacing="12.0" GridPane.columnIndex="1">
                                            <children>
                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="stat-card-title" text="PASSWORD" />
                                                        <!-- PATTERN:DYNAMIC passwordStatus : password last changed string -->
                                                        <Label fx:id="passwordStatusLabel" styleClass="form-label" text="" />
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <VBox alignment="CENTER_RIGHT" spacing="8.0">
                                                    <children>
                                                        <!-- PATTERN:ACTION handleForgotPassword -->
                                                        <Button onAction="#handleForgotPassword" styleClass="secondary-button" text="Forgot password" />
                                                        <!-- PATTERN:ACTION handleChangePassword -->
                                                        <Button onAction="#handleChangePassword" styleClass="secondary-button" text="Change password" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <!-- DYNAMIC DIALOG OVERLAY INCLUSION -->
        <fx:include fx:id="dialog" managed="false" source="shared/dialog.fxml" visible="false" />

    </children>
</StackPane>