<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- In-shell screen. Shared: it asks for "my" history and never checks the role. -->
<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.HistoryController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label styleClass="page-title" text="History" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="dashboard-subtitle" text="Period" />
                        <ComboBox fx:id="periodCombo" prefWidth="170.0" />
                    </children>
                </HBox>
                <HBox spacing="16.0">
                    <children>
                        <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="KG RESCUED" />
                                <Label fx:id="kgLabel" styleClass="dashboard-metric-value" />
                                <Label styleClass="dashboard-subtitle" text="Total rescued to date" />
                            </children>
                        </VBox>
                        <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="HANDOFFS COMPLETED" />
                                <Label fx:id="handoffsLabel" styleClass="dashboard-metric-value" />
                                <Label styleClass="dashboard-subtitle" text="Picked up and confirmed" />
                            </children>
                        </VBox>
                        <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="PARTNERS" />
                                <Label fx:id="partnersLabel" styleClass="dashboard-metric-value" />
                                <Label styleClass="dashboard-subtitle" text="Different organizations" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="12.0" styleClass="table-card">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <HBox styleClass="tab-strip">
                                    <children>
                                        <Button fx:id="allTab" onAction="#handleAll" styleClass="tab-button" />
                                        <Button fx:id="rescuedTab" onAction="#handleRescued" styleClass="tab-button" />
                                        <Button fx:id="expiredTab" onAction="#handleExpired" styleClass="tab-button" />
                                        <Button fx:id="cancelledTab" onAction="#handleCancelled" styleClass="tab-button" />
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="searchField" prefWidth="260.0" promptText="Search food or organization..." />
                            </children>
                        </HBox>
                        <!-- PATTERN:LIST tableBox : header and rows built in the controller -->
                        <VBox fx:id="tableBox" spacing="4.0" />
                        <Label fx:id="emptyLabel" styleClass="dashboard-subtitle" text="Nothing has closed yet." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
