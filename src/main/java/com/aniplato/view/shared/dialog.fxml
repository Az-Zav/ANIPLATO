<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    The one dialog card. DialogController fills it from a DialogSpec: the icon, the heading and subheading, the content
    blocks (inserted between the heading and the message line) and the buttons. There is no other dialog FXML.
-->
<VBox fx:id="overlay" alignment="CENTER" styleClass="modal-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.DialogController">
    <stylesheets>
        <URL value="@../aniplato.css" />
    </stylesheets>
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
    </padding>
    <children>
        <VBox fx:id="card" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox fx:id="header" spacing="16.0">
                    <children>
                        <StackPane fx:id="iconHost" />
                        <VBox fx:id="headingBox" spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="titleLabel" styleClass="modal-title" />
                                <Label fx:id="subtitleLabel" styleClass="text-muted" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Errors and confirmations of this dialog (Inline); hidden until there is something to say. -->
                <Label fx:id="messageLabel" managed="false" maxWidth="1.7976931348623157E308" styleClass="modal-message, error-text" visible="false" wrapText="true" />

                <HBox fx:id="buttonRow" alignment="CENTER_LEFT" spacing="12.0" />
            </children>
        </VBox>
    </children>
</VBox>
