<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="overlay" alignment="CENTER" styleClass="modal-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.DialogController">
    <stylesheets>
        <URL value="@../aniplato.css" />
    </stylesheets>
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
    </padding>
    <children>

        <!-- One file per dialog in dialog/, one controller each in controller/shared/dialog/. -->
        <fx:include fx:id="reject" source="dialog/reject.fxml" />
        <fx:include fx:id="approve" source="dialog/approve.fxml" />
        <fx:include fx:id="resolveSafety" source="dialog/resolve-safety.fxml" />
        <fx:include fx:id="suspend" source="dialog/suspend-account.fxml" />
        <fx:include fx:id="reinstate" source="dialog/reinstate-account.fxml" />
        <fx:include fx:id="cancelListing" source="dialog/cancel-listing.fxml" />
        <fx:include fx:id="confirmRelease" source="dialog/confirm-release.fxml" />
        <fx:include fx:id="flagSafety" source="dialog/flag-safety.fxml" />
        <fx:include fx:id="acceptOffer" source="dialog/accept-offer.fxml" />
        <fx:include fx:id="uploadRenewal" source="dialog/upload-renewal.fxml" />
        <fx:include fx:id="setNewPassword" source="dialog/set-new-password.fxml" />
        <fx:include fx:id="withdrawOffer" source="dialog/withdraw-offer.fxml" />
        <fx:include fx:id="confirmReceipt" source="dialog/confirm-receipt.fxml" />
        <fx:include fx:id="forgotPassword" source="dialog/forgot-password.fxml" />
        <fx:include fx:id="upgradeBusinessDonor" source="dialog/upgrade-business-donor.fxml" />
    </children>
</VBox>
