<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.PostedDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <StackPane fx:id="postedIconBox" styleClass="modal-icon-green-box" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="postedTitleLabel" styleClass="modal-title" text="Done" />
                                <Label fx:id="postedDescriptionLabel" styleClass="text-muted" text="Your changes were saved." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <!-- PATTERN:ACTION the optional second choice (for example Post another) -->
                        <Button fx:id="postedSecondaryButton" onAction="#handleSecondary" styleClass="secondary-button" text="Post another" />
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- PATTERN:ACTION the main choice (for example View my listings) -->
                        <Button fx:id="postedPrimaryButton" minWidth="140.0" onAction="#handlePrimary" styleClass="primary-button" text="Continue" />
                    </children>
                </HBox>
            </children>
        </VBox>
