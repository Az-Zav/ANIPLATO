<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.CancelListingDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <StackPane fx:id="cancelListingIconBox" styleClass="modal-icon-red-box" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="modal-title" text="Cancel this listing?" />
                                <Label fx:id="cancelListingDescriptionLabel" styleClass="text-muted" text="Artisan Sourdough &amp; Baguettes leaves the board. San Roque Parish Feeding Mission’s accepted offer is cancelled with it, and they see your reason." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="form-label" text="Reason *" />
                        <TextArea fx:id="cancelListingReasonTextArea" prefRowCount="3" promptText="e.g., Our staff already gave it away." styleClass="text-area" wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="130.0" onAction="#handleConfirmCancelListing" styleClass="danger-button" text="✕ Cancel listing" />
                    </children>
                </HBox>
            </children>
        </VBox>
