<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.UploadRenewalDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <StackPane fx:id="uploadRenewalIconBox" styleClass="modal-icon-green-box" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="uploadRenewalTitleLabel" styleClass="modal-title" text="Upload renewal: Sanitary Permit" />
                                <Label styleClass="text-muted" text="Upload the renewed permit and type its new expiry date. Your current file stays on record until an admin verifies the new one." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="16.0">
                    <children>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="Renewed document *" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleChooseRenewalFile" styleClass="secondary-button" text="⇪  Upload PDF, JPG or PNG (max 5 MB)" />
                                <Label fx:id="selectedRenewalFileLabel" styleClass="doc-subtitle" text="No file chosen" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="New expiry date *" />
                                <TextField fx:id="newExpiryDateField" promptText="MM / DD / YYYY" styleClass="text-field" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="150.0" onAction="#handleConfirmUploadRenewal" styleClass="primary-button" text="Submit for review" />
                    </children>
                </HBox>
            </children>
        </VBox>
