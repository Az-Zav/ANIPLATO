<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.FlagSafetyDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <Label styleClass="modal-icon-red" text="⚠" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="modal-title" text="Flag a safety concern" />
                                <Label styleClass="text-muted" text="Describe the safety concern. The other party and the ANIPLATO admin will be notified. Admin may dismiss the notice or suspend the account responsible." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="form-label" text="Concern *" />
                        <TextArea fx:id="flagSafetyConcernTextArea" prefRowCount="3" promptText="What happened? e.g., Trays were warm and smelled sour at pickup." styleClass="text-area" wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="120.0" onAction="#handleConfirmFlagSafety" styleClass="danger-button" text="Send to admin" />
                    </children>
                </HBox>
            </children>
        </VBox>
