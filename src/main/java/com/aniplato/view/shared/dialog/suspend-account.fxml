<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.SuspendAccountDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <StackPane fx:id="suspendIconBox" styleClass="modal-icon-red-box" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="modal-title" text="Suspend this account?" />
                                <Label fx:id="suspendDescriptionLabel" styleClass="text-muted" text="Pioneer Catering Services can still log in, upload renewals and finish handoffs it already accepted. It can’t post, re-post, offer or accept, and its listings are hidden from food groups, until you reinstate it." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="form-label" text="Reason (shown to the organization) *" />
                        <TextArea fx:id="suspendReasonTextArea" prefRowCount="3" promptText="e.g., Safety notice #12 confirmed." styleClass="text-area" wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="110.0" onAction="#handleConfirmSuspend" styleClass="danger-button" text="✕ Suspend" />
                    </children>
                </HBox>
            </children>
        </VBox>
