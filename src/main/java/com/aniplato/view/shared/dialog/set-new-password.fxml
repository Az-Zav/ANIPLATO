<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.SetNewPasswordDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <StackPane fx:id="setNewPasswordIconBox" styleClass="modal-icon-green-box" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="modal-title" text="Set a new password" />
                                <Label styleClass="text-muted" text="You’re logged in with the temporary password from your approval email. Choose your own password to continue." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="16.0">
                    <children>
                        <!-- CURRENT PASSWORD FIELD (hidden on first login: the login password is passed in) -->
                        <VBox fx:id="currentPasswordRow" spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="Current password *" />
                                <PasswordField fx:id="currentPasswordField" promptText="Your current password" styleClass="text-field" />
                            </children>
                        </VBox>

                        <!-- NEW PASSWORD FIELD -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="New password *" />
                                <PasswordField fx:id="newPasswordField" promptText="At least 8 characters" styleClass="text-field" />
                            </children>
                        </VBox>

                        <!-- CONFIRM NEW PASSWORD FIELD -->
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="Confirm new password *" />
                                <PasswordField fx:id="confirmPasswordField" promptText="Type it again" styleClass="text-field" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Label styleClass="text-muted" text="This step can’t be skipped. You’ll see it each time you log in with the temporary password until you set your own." wrapText="true" />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="140.0" onAction="#handleConfirmSetNewPassword" styleClass="primary-button" text="Save password" />
                    </children>
                </HBox>
            </children>
        </VBox>
