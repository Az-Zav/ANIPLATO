<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.ConfirmReleaseDialogController" managed="false" maxWidth="520.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <Label styleClass="modal-icon-green" text="📦" />
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="modal-title" text="Confirm release?" />
                                <Label styleClass="text-muted" text="Confirm that this food was handed over to the food group." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <GridPane hgap="12.0" styleClass="notice-box" vgap="8.0">
                    <padding>
                        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="30.0" />
                        <ColumnConstraints percentWidth="70.0" />
                    </columnConstraints>
                    <children>
                        <Label styleClass="text-muted" text="Food" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="releaseFoodLabel" styleClass="form-label" text="Artisan Sourdough &amp; Baguettes" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="text-muted" text="Quantity" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="releaseQuantityLabel" styleClass="form-label" text="45 kg (as listed)" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="text-muted" text="Food group" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="releaseFoodGroupLabel" styleClass="form-label" text="San Roque Parish Feeding Mission" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label styleClass="text-muted" text="Pickup" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="releasePickupLabel" styleClass="form-label" text="Today, 4:00 PM" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label styleClass="text-muted" text="Contact" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="releaseContactLabel" styleClass="form-label" text="Fr. Ramon Cruz · 0917 555 0142" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </children>
                </GridPane>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="form-label" text="Before releasing" />
                        <CheckBox fx:id="releaseSealedCheck" selected="true" styleClass="small-check" text="Packaging is sealed and clean" />
                        <CheckBox fx:id="releaseStorageCheck" selected="true" styleClass="small-check" text="Food was kept at its storage condition" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="tag-reregistered">
                    <padding>
                        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                    </padding>
                    <children>
                        <Label styleClass="required-star" text="ⓘ" />
                        <Label fx:id="releaseNoticeLabel" styleClass="text-muted" text="San Roque hasn’t confirmed receipt yet. The listing becomes Rescued once they do." wrapText="true" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <Hyperlink onAction="#handleSwitchToFlagSafety" styleClass="required-star" text="Something wrong with the food? Flag a safety concern" />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="130.0" onAction="#handleConfirmRelease" styleClass="primary-button" text="Confirm Release" />
                    </children>
                </HBox>
            </children>
        </VBox>
