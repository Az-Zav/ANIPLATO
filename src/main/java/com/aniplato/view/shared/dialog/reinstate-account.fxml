<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.ReinstateAccountDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <StackPane fx:id="reinstateIconBox" styleClass="modal-icon-green-box" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="modal-title" text="Reinstate this account?" />
                                <Label fx:id="reinstateDescriptionLabel" styleClass="text-muted" text="Tondo Community Kitchen gets full access again. Its renewed DSWD certificate was verified on Oct 7, 2026." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="110.0" onAction="#handleConfirmReinstate" styleClass="primary-button" text="Reinstate" />
                    </children>
                </HBox>
            </children>
        </VBox>
