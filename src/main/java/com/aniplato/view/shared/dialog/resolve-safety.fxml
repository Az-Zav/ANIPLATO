<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.ResolveSafetyDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <Label styleClass="modal-icon-red" text="⚠" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="modal-title" text="Resolve safety notice" />
                                <Label fx:id="safetyNoticeDescriptionLabel" styleClass="text-muted" text="Flagged by San Roque Parish Feeding Mission on Oct 6, 7:40 PM: &quot;Pancit trays were warm and smelled sour at pickup.&quot; Close it as dismissed, or suspend Pioneer Catering Services." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="form-label" text="Admin note *" />
                        <TextArea fx:id="safetyAdminNoteTextArea" prefRowCount="3" promptText="Short note for the record" styleClass="text-area" wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="90.0" onAction="#handleDismissSafetyNotice" styleClass="secondary-button" text="Dismiss" />
                        <Button minWidth="140.0" onAction="#handleSuspendFromSafetyNotice" styleClass="danger-button" text="Suspend account" />
                    </children>
                </HBox>
            </children>
        </VBox>
