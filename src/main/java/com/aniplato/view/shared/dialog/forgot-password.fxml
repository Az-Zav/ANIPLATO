<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

        <VBox fx:id="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.dialog.ForgotPasswordDialogController" managed="false" maxWidth="480.0" spacing="20.0" styleClass="modal-card" visible="false">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <StackPane fx:id="forgotPasswordIconBox" styleClass="modal-icon-green-box" />
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="modal-title" text="Forgot your password?" />
                                <Label styleClass="text-muted" text="Enter your account's email address below. If an account matches, we'll send instructions to reset your password." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="form-label" text="Enter your email *" />
                        <TextField fx:id="forgotPasswordEmailField" promptText="e.g., name@organization.ph" styleClass="text-field" />
                        <Label styleClass="text-muted" text="We'll send a password reset link or temporary access code to this address." wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleCancel" styleClass="secondary-button" text="← Back" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="130.0" onAction="#handleConfirmForgotPassword" styleClass="primary-button" text="Send reset email" />
                    </children>
                </HBox>
            </children>
        </VBox>
