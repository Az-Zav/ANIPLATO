<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.shared.HandoffRecordController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="page-title" text="Handoff Record" />
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- PATTERN:DYNAMIC submitReportButton : shown only to the food group that still owes the report -->
                        <Button fx:id="submitReportButton" onAction="#handleSubmitReport" styleClass="primary-button" text="Submit report" />
                    </children>
                </HBox>
                <!-- PATTERN:DYNAMIC recordBox : the record and, once submitted, the report -->
                <VBox fx:id="recordBox" spacing="12.0" />
                <Label fx:id="disclaimerLabel" styleClass="text-muted" wrapText="true" />
                <!-- PATTERN:ACTION handleBack -->
                <Button onAction="#handleBack" styleClass="secondary-button" text="Back" />
            </children>
        </VBox>
    </content>
</ScrollPane>
