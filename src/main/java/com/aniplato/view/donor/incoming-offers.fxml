<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- The offers on one listing: the controller builds the page in code (controller/board/OffersPage) and puts it in pageHost. -->
<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.donor.IncomingOffersController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <!-- PATTERN:LIST pageHost : the whole page, built in the controller -->
                <VBox fx:id="pageHost" spacing="16.0" />
                <fx:include fx:id="dialog" source="../shared/dialog.fxml" />
            </children>
        </VBox>
    </content>
</ScrollPane>
