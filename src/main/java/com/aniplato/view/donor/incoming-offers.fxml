<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.donor.IncomingOffersController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="page-title" text="Incoming Offers" />
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <Label styleClass="text-muted" text="Offers on your listings. Accept one and the others are declined; both sides then see each other's contact number." wrapText="true" />
                <!-- PATTERN:LIST rowsBox : one card per row, built in the controller -->
                <VBox fx:id="rowsBox" spacing="12.0" />
                <!-- PATTERN:DYNAMIC emptyLabel : shown when there are no rows -->
                <Label fx:id="emptyLabel" styleClass="text-muted" text="No offers have come in yet." wrapText="true" />
                <fx:include fx:id="dialog" source="../shared/dialog.fxml" />
            </children>
        </VBox>
    </content>
</ScrollPane>
