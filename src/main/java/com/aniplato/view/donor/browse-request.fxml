<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.donor.BrowseRequestsController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="page-title" text="Browse Requests" />
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- PATTERN:ACTION handleRefresh -->
                        <Button onAction="#handleRefresh" styleClass="table-review-btn" text="Refresh" />
                    </children>
                </HBox>
                <HBox spacing="16.0">
                    <children>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="OPEN REQUESTS" />
                                <Label styleClass="metric-value" text="6" />
                                <Label styleClass="metric-caption" text="4 in Mandaluyong City · 2 elsewhere" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="CLOSEST NEEDED-BY · TODAY" />
                                <Label styleClass="metric-value" text="6:00 PM" />
                                <Label styleClass="metric-caption" text="Bread for school meals" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="KG NEEDED" />
                                <HBox alignment="BASELINE_LEFT" spacing="5.0">
                                    <children>
                                        <Label styleClass="metric-value" text="210" />
                                        <Label styleClass="stat-unit" text="kg" />
                                    </children>
                                </HBox>
                                <Label styleClass="metric-caption" text="Across 6 open requests" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="14.0" styleClass="table-card" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="18.0" left="20.0" right="20.0" top="18.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <HBox spacing="0.0" styleClass="tab-strip">
                                    <children>
                                        <Button styleClass="tab-button, tab-button-active" text="All (6)" />
                                        <Button styleClass="tab-button" text="Today (2)" />
                                        <Button styleClass="tab-button" text="Tomorrow (4)" />
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField prefWidth="268.0" promptText="Search request or group..." />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="table-header-row">
                            <children>
                                <Label prefWidth="210.0" styleClass="table-header-text" text="REQUEST" />
                                <Label prefWidth="190.0" styleClass="table-header-text" text="ORGANIZATION" />
                                <Label prefWidth="80.0" styleClass="table-header-text" text="KG" />
                                <Label prefWidth="150.0" styleClass="table-header-text" text="NEEDED-BY" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <!-- PATTERN:LIST requestRows : representative open request rows -->
                        <VBox spacing="0.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" styleClass="table-data-row">
                                    <children>
                                        <Label prefWidth="210.0" styleClass="table-cell-primary" text="Bread for school meals" />
                                        <Label prefWidth="190.0" styleClass="table-cell-text" text="San Roque Parish Feeding Mission" wrapText="true" />
                                        <Label prefWidth="80.0" styleClass="table-cell-text" text="40 kg" />
                                        <Label prefWidth="150.0" styleClass="table-cell-text" text="Today, 6:00 PM" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <!-- PATTERN:ACTION handleMakeOffer -->
                                        <Button onAction="#handleMakeOffer" styleClass="table-review-btn" text="Make offer" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" styleClass="table-data-row">
                                    <children>
                                        <Label prefWidth="210.0" styleClass="table-cell-primary" text="Breakfast packs for tomorrow" />
                                        <Label prefWidth="190.0" styleClass="table-cell-text" text="Hulo Community Kitchen" wrapText="true" />
                                        <Label prefWidth="80.0" styleClass="table-cell-text" text="60 kg" />
                                        <Label prefWidth="150.0" styleClass="table-cell-text" text="Tomorrow, 7:30 AM" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <!-- PATTERN:ACTION handleMakeOffer -->
                                        <Button onAction="#handleMakeOffer" styleClass="table-review-btn" text="Make offer" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <Label styleClass="table-footer-note" text="Requests are shown for organizations looking for surplus food near you." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
