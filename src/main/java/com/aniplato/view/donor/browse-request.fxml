<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- A board screen: the controller builds the title, tiles, tabs and table in code (controller/board/Board) and puts them in boardHost. -->
<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.donor.BrowseRequestsController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <!-- PATTERN:LIST boardHost : the whole board, built in the controller -->
                <VBox fx:id="boardHost" spacing="16.0" />
            </children>
        </VBox>
    </content>
</ScrollPane>
