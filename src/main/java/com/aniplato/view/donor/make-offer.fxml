<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import com.aniplato.controller.DateTimeField?>
<?import com.aniplato.controller.PhotoPicker?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.donor.MakeOfferController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <Label styleClass="page-title" text="Make an Offer" />
                <!-- PATTERN:DYNAMIC summaryBox : the request being offered on -->
                <VBox fx:id="summaryBox" />
                <VBox spacing="18.0" styleClass="table-card">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                    <children>
                        <Label styleClass="text-muted" text="You can offer less than the amount requested. Only the food group can see your offer." wrapText="true" />
                        <Label styleClass="form-label" text="Describe the food *" />
                        <TextField fx:id="descriptionField" promptText="e.g. Sacks of rice" />
                        <Label styleClass="form-label" text="Category *" />
                        <ComboBox fx:id="categoryCombo" maxWidth="1.7976931348623157E308" promptText="Pick one" />
                        <Label styleClass="form-label" text="Storage condition *" />
                        <ComboBox fx:id="storageCombo" maxWidth="1.7976931348623157E308" promptText="Pick one" />
                        <Label styleClass="form-label" text="Allergen labels (for information only)" />
                        <!-- PATTERN:DYNAMIC allergenBox : one check box per allergen -->
                        <FlowPane fx:id="allergenBox" hgap="16.0" vgap="8.0" />
                        <Label styleClass="form-label" text="Weight you offer (kg) *" />
                        <TextField fx:id="kgField" promptText="10" />
                        <Label styleClass="form-label" text="Safe use-by *" />
                        <DateTimeField fx:id="useByField" />
                        <Label styleClass="form-label" text="Pickup window starts *" />
                        <DateTimeField fx:id="pickupStartField" />
                        <Label styleClass="form-label" text="Pickup window ends *" />
                        <DateTimeField fx:id="pickupEndField" />
                        <Label styleClass="text-muted" text="The window must end before the use-by and before the request's needed-by time." wrapText="true" />
                        <Label styleClass="form-label" text="Photos of the food *" />
                        <PhotoPicker fx:id="photoPicker" />
                        <Label styleClass="form-label" text="Handover instructions (optional)" />
                        <TextArea fx:id="handoverArea" prefRowCount="3" wrapText="true" />
                        <Label styleClass="text-muted" text="Shown to the food group only after it accepts your offer." wrapText="true" />
                        <VBox spacing="6.0" styleClass="table-card">
                            <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0" /></padding>
                            <children>
                                <CheckBox fx:id="attestationCheck" text="Donor attestation *" />
                                <Label styleClass="text-muted" text="This food is apparently wholesome, properly labeled and donated in good faith. It contains no milk products, no tomato- or milk-based cooked food, and no food already served to diners." wrapText="true" />
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <!-- PATTERN:NAV -> DONOR_BROWSE_REQUESTS -->
                                <Button styleClass="secondary-button, nav-donor-browse-requests" text="Cancel" />
                                <!-- PATTERN:ACTION handleSend -->
                                <Button onAction="#handleSend" styleClass="primary-button" text="Send offer" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
