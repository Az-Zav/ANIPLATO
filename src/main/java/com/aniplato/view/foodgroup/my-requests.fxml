<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.foodgroup.MyRequestsController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="24.0" right="24.0" top="24.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT"><children><Label styleClass="page-title" text="My Requests" /><Region HBox.hgrow="ALWAYS" /><!-- PATTERN:NAV -> NEW_REQUEST --><Button styleClass="primary-button, nav-new-request" text="+ New Request" /></children></HBox>
                <HBox spacing="16.0">
                    <children>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS"><children><Label styleClass="stat-card-title" text="OPEN REQUESTS" /><Label styleClass="metric-value" text="2" /><Label styleClass="metric-caption" text="55 kg needed" /></children></VBox>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS"><children><Label styleClass="stat-card-title" text="ACCEPTED, AWAITING PICKUP" /><Label styleClass="metric-value" text="2" /><Label styleClass="metric-caption" text="100 kg · confirm at pickup" /></children></VBox>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS"><children><Label styleClass="stat-card-title" text="OFFERS TO REVIEW" /><Label styleClass="metric-value" text="3" /><Label styleClass="metric-caption" text="On 1 open request" /></children></VBox>
                    </children>
                </HBox>
                <VBox spacing="14.0" styleClass="table-card">
                    <padding><Insets bottom="18.0" left="20.0" right="20.0" top="18.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT"><children><HBox styleClass="tab-strip"><children><Button styleClass="tab-button, tab-button-active" text="All (4)" /><Button styleClass="tab-button" text="Accepted (2)" /><Button styleClass="tab-button" text="Open (2)" /></children></HBox><Region HBox.hgrow="ALWAYS" /><TextField prefWidth="220.0" promptText="⌕  Search request or donor..." /></children></HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="table-header-row"><children><Label prefWidth="180.0" styleClass="table-header-text" text="REQUEST" /><Label prefWidth="65.0" styleClass="table-header-text" text="KG" /><Label prefWidth="115.0" styleClass="table-header-text" text="NEEDED-BY" /><Label prefWidth="80.0" styleClass="table-header-text" text="STATUS" /><Label prefWidth="180.0" styleClass="table-header-text" text="ACCEPTED OFFER" /><Label prefWidth="85.0" styleClass="table-header-text" text="PICKUP" /><Label styleClass="table-header-text" text="RECEIPT" /></children></HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="180.0" styleClass="table-cell-primary" text="Bread for school meals" wrapText="true" /><Label prefWidth="65.0" styleClass="table-cell-text" text="40 kg" /><Label prefWidth="115.0" styleClass="table-cell-muted" text="Today, 6:00 PM" /><Label prefWidth="80.0" styleClass="status-pill status-accepted" text="Accepted" /><VBox prefWidth="180.0"><children><Label styleClass="table-cell-primary" text="Manila Artisanal Bakeshop" /><Label styleClass="table-cell-muted" text="Maria Santos · 0917 123 4567" /></children></VBox><Label prefWidth="85.0" styleClass="table-cell-muted" text="Today, 4:30 PM" /><VBox><children><!-- PATTERN:ACTION handleConfirmReceipt --><Button onAction="#handleConfirmReceipt" styleClass="table-review-btn small-button" text="Confirm Receipt" /><Button styleClass="link-button" text="Cancel request" /></children></VBox></children></HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="180.0" styleClass="table-cell-primary" text="Meals for 120 kids" wrapText="true" /><Label prefWidth="65.0" styleClass="table-cell-text" text="60 kg" /><Label prefWidth="115.0" styleClass="table-cell-muted" text="Today, 8:00 PM" /><Label prefWidth="80.0" styleClass="status-pill status-accepted" text="Accepted" /><VBox prefWidth="180.0"><children><Label styleClass="table-cell-primary" text="Pioneer Catering Services" /><Label styleClass="table-cell-muted" text="Joel Mendoza · 0917 321 6655" /></children></VBox><Label prefWidth="85.0" styleClass="table-cell-muted" text="Today, 6:30 PM" /><VBox><children><Button onAction="#handleConfirmReceipt" styleClass="table-review-btn small-button" text="Confirm Receipt" /><Button styleClass="link-button" text="Cancel request" /></children></VBox></children></HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="180.0" styleClass="table-cell-primary" text="Vegetables for pantry" wrapText="true" /><Label prefWidth="65.0" styleClass="table-cell-text" text="30 kg" /><Label prefWidth="115.0" styleClass="table-cell-muted" text="Tomorrow, 9:00 AM" /><Label prefWidth="80.0" styleClass="status-pill status-offered" text="Open" /><Label prefWidth="180.0" styleClass="text-success-bold" text="3 offers" /><Label prefWidth="85.0" styleClass="table-cell-muted" text="—" /><VBox><!-- PATTERN:ACTION handleReviewOffers --><children><Button onAction="#handleReviewOffers" styleClass="table-review-btn small-button" text="Review offers" /><Button styleClass="link-button" text="Cancel request" /></children></VBox></children></HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="180.0" styleClass="table-cell-primary" text="Canned relief goods" wrapText="true" /><Label prefWidth="65.0" styleClass="table-cell-text" text="25 kg" /><Label prefWidth="115.0" styleClass="table-cell-muted" text="Tomorrow, 11:00 AM" /><Label prefWidth="80.0" styleClass="status-pill status-offered" text="Open" /><Label prefWidth="180.0" styleClass="text-muted" text="No offers yet" /><Label prefWidth="85.0" styleClass="table-cell-muted" text="—" /><Button styleClass="link-button" text="Cancel request" /></children></HBox>
                        <Label styleClass="table-footer-note" text="Rescued, expired and cancelled requests move to History." />
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
