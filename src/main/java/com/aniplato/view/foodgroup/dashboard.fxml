<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- In-shell screen: header, sidebar and logout come from shared/shell.fxml -->
<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.foodgroup.FoodGroupDashboardController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="20.0" styleClass="dashboard-bg">
            <padding><Insets bottom="24.0" left="32.0" right="32.0" top="24.0" /></padding>
            <children>
                <!-- PATTERN:LIST alertBox : banners for a suspension, documents ending, a report due -->
                <VBox fx:id="alertBox" spacing="8.0" />
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="welcomeLabel" styleClass="dashboard-title" />
                                <Label fx:id="cityLabel" styleClass="dashboard-subtitle" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- PATTERN:NAV -> BROWSE_LISTINGS -->
                        <Button styleClass="primary-button, nav-browse-listings" text="Browse Listings" />
                    </children>
                </HBox>
                <HBox spacing="16.0">
                    <children>
                        <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="OPEN LISTINGS" wrapText="true" />
                                <!-- PATTERN:DYNAMIC openListingsValueLabel : the figure -->
                                <Label fx:id="openListingsValueLabel" styleClass="dashboard-metric-value" />
                                <!-- PATTERN:DYNAMIC openListingsSubLabel : the line under it -->
                                <Label fx:id="openListingsSubLabel" styleClass="dashboard-subtitle" wrapText="true" />
                            </children>
                        </VBox>
                        <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="ACCEPTED OFFERS" wrapText="true" />
                                <!-- PATTERN:DYNAMIC acceptedValueLabel : the figure -->
                                <Label fx:id="acceptedValueLabel" styleClass="dashboard-metric-value" />
                                <!-- PATTERN:DYNAMIC acceptedSubLabel : the line under it -->
                                <Label fx:id="acceptedSubLabel" styleClass="dashboard-subtitle" wrapText="true" />
                            </children>
                        </VBox>
                        <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-card-title" text="KG RESCUED" wrapText="true" />
                                <!-- PATTERN:DYNAMIC rescuedValueLabel : the figure -->
                                <Label fx:id="rescuedValueLabel" styleClass="dashboard-metric-value" />
                                <!-- PATTERN:DYNAMIC rescuedSubLabel : the line under it -->
                                <Label fx:id="rescuedSubLabel" styleClass="dashboard-subtitle" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="12.0" styleClass="table-card">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="dashboard-section-title" text="Open Listings Near You" />
                                <Region HBox.hgrow="ALWAYS" />
                                <!-- PATTERN:NAV -> BROWSE_LISTINGS -->
                                <Button styleClass="secondary-button, nav-browse-listings" text="View all →" />
                            </children>
                        </HBox>
                        <!-- PATTERN:LIST tableBox : header and rows built in the controller -->
                        <VBox fx:id="tableBox" spacing="4.0" />
                        <!-- PATTERN:DYNAMIC emptyLabel : shown when there is nothing to list -->
                        <Label fx:id="emptyLabel" styleClass="dashboard-subtitle" text="No listings are open right now." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
