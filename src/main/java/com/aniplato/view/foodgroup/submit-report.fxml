<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import com.aniplato.controller.PhotoPicker?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.foodgroup.SubmitReportController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <Label styleClass="page-title" text="Submit Report" />
                <!-- PATTERN:DYNAMIC dueLabel : the report deadline -->
                <Label fx:id="dueLabel" styleClass="text-muted" wrapText="true" />
                <VBox spacing="18.0" styleClass="table-card">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                    <children>
                        <Label styleClass="form-label" text="Event or program name *" />
                        <TextField fx:id="eventNameField" />
                        <Label styleClass="form-label" text="Event date *" />
                        <DatePicker fx:id="eventDatePicker" maxWidth="1.7976931348623157E308" />
                        <Label styleClass="form-label" text="People actually served *" />
                        <TextField fx:id="peopleServedField" promptText="55" />
                        <Label styleClass="form-label" text="What happened *" />
                        <TextArea fx:id="descriptionArea" prefRowCount="5" wrapText="true" />
                        <Label styleClass="form-label" text="Photos *" />
                        <PhotoPicker fx:id="photoPicker" />
                        <VBox spacing="6.0" styleClass="table-card">
                            <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0" /></padding>
                            <children>
                                <CheckBox fx:id="consentCheck" text="Photo consent *" />
                                <Label styleClass="text-muted" text="Photos show no identifiable children, and identifiable adults have consented." wrapText="true" />
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <!-- PATTERN:ACTION handleBack -->
                                <Button onAction="#handleBack" styleClass="secondary-button" text="Back" />
                                <!-- PATTERN:ACTION handleSubmit -->
                                <Button onAction="#handleSubmit" styleClass="primary-button" text="Submit report" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
