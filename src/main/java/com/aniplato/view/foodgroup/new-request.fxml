<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import com.aniplato.controller.DateTimeField?>
<?import com.aniplato.controller.PhotoPicker?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.foodgroup.NewRequestController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="24.0" /></padding>
            <children>
                <Label styleClass="page-title" text="New Request" />
                <VBox spacing="18.0" styleClass="table-card">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                    <children>
                        <Label styleClass="section-title" text="The event or program" />
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="Event or program name *" />
                                <TextField fx:id="eventNameField" promptText="e.g. Weekend feeding program" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="Event date *" />
                                <DatePicker fx:id="eventDatePicker" maxWidth="1.7976931348623157E308" />
                                <Label styleClass="text-muted" text="On or after the needed-by date." />
                            </children>
                        </VBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="Who it feeds *" />
                                <TextField fx:id="beneficiariesField" promptText="e.g. Street children and elderly" />
                                <Label styleClass="form-label" text="How many people *" />
                                <TextField fx:id="headcountField" promptText="80" />
                                <Label styleClass="form-label" text="Where the food should go *" />
                                <TextField fx:id="placeField" promptText="Address or venue" />
                            </children>
                        </VBox>
                        <Label styleClass="section-title" text="The food you need" />
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="Categories you will accept *" />
                                <!-- PATTERN:DYNAMIC categoryBox : one check box per category -->
                                <FlowPane fx:id="categoryBox" hgap="16.0" vgap="8.0" />
                                <Label styleClass="form-label" text="Weight needed (kg) *" />
                                <TextField fx:id="kgField" promptText="30" />
                                <Label styleClass="form-label" text="Needed by *" />
                                <DateTimeField fx:id="neededByField" />
                                <Label styleClass="text-muted" text="A request with no donor chosen by this time expires." wrapText="true" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="section-title" text="Photos" />
                                <Label styleClass="text-muted" text="Past events or the venue; the recipients if it is a new event. No identifiable children." wrapText="true" />
                                <PhotoPicker fx:id="photoPicker" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="form-label" text="Message to donors (optional)" />
                                <TextArea fx:id="messageArea" prefRowCount="3" wrapText="true" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0" styleClass="table-card">
                            <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0" /></padding>
                            <children>
                                <CheckBox fx:id="attestationCheck" text="Group attestation *" />
                                <Label styleClass="text-muted" text="We will give this food away free, will not sell it, and will handle it safely after pickup. Photos show no identifiable children, and identifiable adults have consented." wrapText="true" />
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <!-- PATTERN:ACTION handleCancel -->
                                <Button onAction="#handleCancel" styleClass="secondary-button" text="Cancel" />
                                <!-- PATTERN:ACTION handlePost -->
                                <Button onAction="#handlePost" prefWidth="117.0" styleClass="primary-button" text="Post" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
