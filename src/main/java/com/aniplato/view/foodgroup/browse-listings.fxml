<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.foodgroup.BrowseListingsController">
    <stylesheets><URL value="@../aniplato.css" /></stylesheets>
    <content>
        <VBox spacing="16.0" styleClass="dashboard-bg">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="page-title" text="Browse Listings" />
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- PATTERN:ACTION handleRefresh -->
                        <Button onAction="#handleRefresh" styleClass="table-review-btn" text="↻  Refresh" />
                    </children>
                </HBox>
                <HBox spacing="16.0">
                    <children>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label styleClass="metric-icon metric-icon-blue" text="▣" /><Label styleClass="stat-card-title" text="OPEN SURPLUS" /></children></HBox>
                                <Label styleClass="metric-value" text="5" />
                                <Label styleClass="metric-caption" text="In Mandaluyong City" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label styleClass="metric-icon metric-icon-orange" text="◷" /><Label styleClass="stat-card-title" text="CLOSEST USE-BY · TODAY" /></children></HBox>
                                <Label styleClass="metric-value" text="9:00 PM" />
                                <Label styleClass="metric-caption" text="Assorted Pastries &amp; Ensaymada" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0"><children><Label styleClass="metric-icon metric-icon-green" text="⌁" /><Label styleClass="stat-card-title" text="KG AVAILABLE" /></children></HBox>
                                <HBox alignment="BASELINE_LEFT" spacing="5.0"><children><Label styleClass="metric-value" text="155" /><Label styleClass="stat-unit" text="kg" /></children></HBox>
                                <Label styleClass="metric-caption" text="Across 5 open listings" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="14.0" styleClass="table-card" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="18.0" left="20.0" right="20.0" top="18.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <HBox spacing="0.0" styleClass="tab-strip">
                                    <children>
                                        <Button styleClass="tab-button, tab-button-active" text="All (5)" />
                                        <Button styleClass="tab-button" text="Today (2)" />
                                        <Button styleClass="tab-button" text="Tomorrow (3)" />
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField prefWidth="216.0" promptText="⌕  Search food or donor..." />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="table-header-row">
                            <children>
                                <Label prefWidth="200.0" styleClass="table-header-text" text="FOOD" />
                                <Label prefWidth="170.0" styleClass="table-header-text" text="DONOR" />
                                <Label prefWidth="70.0" styleClass="table-header-text" text="KG" />
                                <Label prefWidth="145.0" styleClass="table-header-text" text="USE-BY" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <VBox spacing="0.0">
                            <children>
                                <!-- PATTERN:LIST openListings : exact Figma representative rows -->
                                <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="200.0" styleClass="table-cell-primary" text="Assorted Pastries &amp; Ensaymada" /><Label prefWidth="170.0" styleClass="table-cell-text" text="Manila Artisanal Bakeshop" /><Label prefWidth="70.0" styleClass="table-cell-text" text="28 kg" /><Label prefWidth="145.0" styleClass="table-cell-text" text="Today, 9:00 PM" /><Region HBox.hgrow="ALWAYS" /><!-- PATTERN:ACTION handleMakeOffer --><Button onAction="#handleMakeOffer" styleClass="table-review-btn" text="Make offer" /></children></HBox>
                                <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="200.0" styleClass="table-cell-primary" text="Cooked Pancit Canton Trays" /><Label prefWidth="170.0" styleClass="table-cell-text" text="Pioneer Catering Services" /><Label prefWidth="70.0" styleClass="table-cell-text" text="32 kg" /><Label prefWidth="145.0" styleClass="table-cell-text" text="Today, 10:30 PM" /><Region HBox.hgrow="ALWAYS" /><Button onAction="#handleMakeOffer" styleClass="table-review-btn" text="Make offer" /></children></HBox>
                                <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="200.0" styleClass="table-cell-primary" text="Brioche &amp; Dinner Rolls" /><Label prefWidth="170.0" styleClass="table-cell-text" text="Manila Artisanal Bakeshop" /><Label prefWidth="70.0" styleClass="table-cell-text" text="35 kg" /><Label prefWidth="145.0" styleClass="table-cell-text" text="Tomorrow, 10:00 AM" /><Region HBox.hgrow="ALWAYS" /><Button onAction="#handleMakeOffer" styleClass="table-review-btn" text="Make offer" /></children></HBox>
                                <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="200.0" styleClass="table-cell-primary" text="Croissants &amp; Danishes" /><Label prefWidth="170.0" styleClass="table-cell-text" text="Manila Artisanal Bakeshop" /><Label prefWidth="70.0" styleClass="table-cell-text" text="20 kg" /><Label prefWidth="145.0" styleClass="table-cell-text" text="Tomorrow, 12:00 PM" /><Region HBox.hgrow="ALWAYS" /><Button onAction="#handleMakeOffer" styleClass="table-review-btn" text="Make offer" /></children></HBox>
                                <HBox alignment="CENTER_LEFT" styleClass="table-data-row"><children><Label prefWidth="200.0" styleClass="table-cell-primary" text="Fresh Pechay &amp; Ampalaya" /><Label prefWidth="170.0" styleClass="table-cell-text" text="Boni Fresh Grocery" /><Label prefWidth="70.0" styleClass="table-cell-text" text="40 kg" /><Label prefWidth="145.0" styleClass="table-cell-text" text="Tomorrow, 2:00 PM" /><Region HBox.hgrow="ALWAYS" /><Button onAction="#handleMakeOffer" styleClass="table-review-btn" text="Make offer" /></children></HBox>
                            </children>
                        </VBox>
                        <Label styleClass="table-footer-note" text="Open listings in Mandaluyong City, soonest use-by first. Your own re-posts are hidden, and a listing leaves the board once the donor accepts an offer." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
