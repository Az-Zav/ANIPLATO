<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<!-- In-shell screen: wrapped in StackPane to support modal dialog overlays -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.admin.ReviewRegistrationController">
    <children>

        <!-- MAIN REVIEW REGISTRATION VIEW -->
        <ScrollPane fitToWidth="true" styleClass="table-scroll">
            <stylesheets>
                <URL value="@../aniplato.css" />
            </stylesheets>
            <content>
                <VBox spacing="20.0" styleClass="dashboard-bg">
                    <stylesheets>
                        <URL value="@../aniplato.css" />
                    </stylesheets>
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
                    </padding>
                    <children>

                        <Label fx:id="pageTitleLabel" styleClass="page-title" text="Review Registration" />

                        <!-- MAIN CARD -->
                        <VBox spacing="20.0" styleClass="table-card" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                            </padding>
                            <children>

                                <!-- BANNER HEADER -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="table-header-row">
                                    <padding>
                                        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
                                    </padding>
                                    <children>
                                        <Label styleClass="stat-icon-green" text="🏢" />
                                        <!-- PATTERN:DYNAMIC orgTitle : organization name -->
                                        <Label fx:id="orgTitleLabel" styleClass="card-title" text="San Antonio Community Pantry" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <!-- PATTERN:DYNAMIC statusPill : "PENDING" -->
                                        <Label fx:id="statusPillLabel" styleClass="tag-reregistered" text="🟠 PENDING" />
                                    </children>
                                </HBox>

                                <!-- ACCOUNT DETAILS FORM GRID -->
                                <GridPane hgap="20.0" vgap="16.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <!-- ORG / BUSINESS / HOUSEHOLD NAME -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label fx:id="nameHeaderLabel" styleClass="stat-card-title" text="ORGANIZATION NAME" />
                                                <HBox alignment="CENTER_LEFT" styleClass="text-field">
                                                    <children>
                                                        <!-- PATTERN:DYNAMIC orgName : organization name -->
                                                        <Label fx:id="orgNameLabel" styleClass="form-label" text="San Antonio Community Pantry" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- ROLE -->
                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="stat-card-title" text="ROLE" />
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <!-- PATTERN:DYNAMIC rolePill : role name -->
                                                        <Label fx:id="rolePillLabel" styleClass="pill-food-org" text="Food group" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- CONTACT PERSON -->
                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <children>
                                                <Label styleClass="stat-card-title" text="CONTACT PERSON" />
                                                <HBox alignment="CENTER_LEFT" styleClass="text-field">
                                                    <children>
                                                        <!-- PATTERN:DYNAMIC contactPerson : contact name & phone -->
                                                        <Label fx:id="contactPersonLabel" styleClass="table-cell-text" text="Elena R. Santos · 0918 234 5671" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- EMAIL -->
                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Label styleClass="stat-card-title" text="EMAIL" />
                                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="text-field">
                                                    <children>
                                                        <Label styleClass="text-muted" text="✉" />
                                                        <!-- PATTERN:DYNAMIC email : organization email -->
                                                        <Label fx:id="emailLabel" styleClass="table-cell-text" text="contact@sanantoniopantry.ph" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- ORGANIZATION TYPE (Hidden for Casual Donors via controller) -->
                                        <VBox fx:id="orgTypeBox" spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <children>
                                                <Label styleClass="stat-card-title" text="ORGANIZATION TYPE" />
                                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="text-field">
                                                    <children>
                                                        <Label styleClass="text-muted" text="👥" />
                                                        <!-- PATTERN:DYNAMIC orgType : entity type -->
                                                        <Label fx:id="orgTypeLabel" styleClass="table-cell-text" text="Charity" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- CITY -->
                                        <VBox fx:id="cityBox" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <children>
                                                <Label styleClass="stat-card-title" text="CITY" />
                                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="text-field">
                                                    <children>
                                                        <Label styleClass="text-muted" text="🏢" />
                                                        <!-- PATTERN:DYNAMIC city : city name -->
                                                        <Label fx:id="cityLabel" styleClass="table-cell-text" text="Pasig City" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <!-- DOCUMENTS SECTION -->
                                <VBox spacing="12.0">
                                    <children>
                                        <Label fx:id="documentsCountHeaderLabel" styleClass="form-label" text="DOCUMENTS (2)" />
                                        <Label styleClass="text-muted" text="Open each file and confirm it is current, the name matches, and it was issued for the applicant's city. Then verify it. Approve unlocks once every required document is verified." wrapText="true" />

                                        <!-- DOCUMENT CARD 1 -->
                                        <VBox spacing="12.0" styleClass="notice-box">
                                            <padding>
                                                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="TOP_LEFT" spacing="16.0">
                                                    <children>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label fx:id="doc1TitleLabel" styleClass="form-label" text="DSWD Certificate of Registration" />
                                                                <!-- PATTERN:DYNAMIC doc1Meta : upload details -->
                                                                <Label fx:id="doc1MetaLabel" styleClass="doc-subtitle" text="Uploaded Oct 1, 2026 · Expires Jun 30, 2027 (entered by applicant)" />
                                                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                                    <children>
                                                                        <Hyperlink onAction="#handleViewDoc1" styleClass="terms-link" text="View file ↗" />
                                                                        <!-- PATTERN:DYNAMIC doc1File : filename -->
                                                                        <Label fx:id="doc1FileLabel" styleClass="table-cell-text" text="dswd-registration.pdf" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>

                                                        <!-- CHECKLIST -->
                                                        <VBox fx:id="doc1Checks" spacing="6.0">
                                                            <children>
                                                                <Label styleClass="doc-subtitle" text="• Current, not expired" />
                                                                <Label styleClass="doc-subtitle" text="• Name matches registration" />
                                                                <Label styleClass="doc-subtitle" text="• Issued for Pasig City" />
                                                            </children>
                                                        </VBox>

                                                        <!-- STATUS / ACTION BUTTONS -->
                                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                            <children>
                                                                <Label fx:id="doc1VerifiedBadge" managed="false" styleClass="pill-food-donor" text="✓ Verified" visible="false" />
                                                                <Hyperlink fx:id="doc1UndoLink" managed="false" onAction="#handleUndoDoc1" styleClass="text-muted" text="Undo" visible="false" />
                                                                <Button fx:id="doc1VerifyBtn" onAction="#handleVerifyDoc1" styleClass="table-review-btn" text="Verify" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- DOCUMENT CARD 2 (Hidden for Casual Donors via controller) -->
                                        <VBox fx:id="doc2Box" spacing="12.0" styleClass="notice-box">
                                            <padding>
                                                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="TOP_LEFT" spacing="16.0">
                                                    <children>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label fx:id="doc2TitleLabel" styleClass="form-label" text="Authorization letter" />
                                                                <!-- PATTERN:DYNAMIC doc2Meta : upload details -->
                                                                <Label fx:id="doc2MetaLabel" styleClass="doc-subtitle" text="Uploaded Oct 1, 2026 · No expiry (marked by applicant) · Must name Elena R. Santos" />
                                                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                                    <children>
                                                                        <Hyperlink onAction="#handleViewDoc2" styleClass="terms-link" text="View file ↗" />
                                                                        <!-- PATTERN:DYNAMIC doc2File : filename -->
                                                                        <Label fx:id="doc2FileLabel" styleClass="table-cell-text" text="authorization-letter.pdf" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>

                                                        <!-- CHECKLIST -->
                                                        <VBox fx:id="doc2Checks" spacing="6.0">
                                                            <children>
                                                                <Label styleClass="doc-subtitle" text="• Current, not expired" />
                                                                <Label styleClass="doc-subtitle" text="• Name matches registration" />
                                                                <Label styleClass="doc-subtitle" text="• Issued for Pasig City" />
                                                            </children>
                                                        </VBox>

                                                        <!-- ACTION BUTTONS -->
                                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                            <children>
                                                                <Label fx:id="doc2VerifiedBadge" managed="false" styleClass="pill-food-donor" text="✓ Verified" visible="false" />
                                                                <Hyperlink fx:id="doc2UndoLink" managed="false" onAction="#handleUndoDoc2" styleClass="text-muted" text="Undo" visible="false" />
                                                                <Button fx:id="doc2VerifyBtn" onAction="#handleVerifyDoc2" styleClass="table-review-btn" text="Verify" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>

                                <!-- PATTERN:DYNAMIC registeredDate : registered date -->
                                <Label fx:id="registeredDateLabel" styleClass="text-muted" text="📅 Registered Oct 1, 2026" />

                            </children>
                        </VBox>

                        <!-- Shown when Approve is pressed before every document is verified (A8) -->
                        <Label fx:id="errorLabel" managed="false" maxWidth="1.7976931348623157E308" styleClass="error-text" visible="false" wrapText="true" />

                        <!-- BOTTOM ACTION BAR -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <children>
                                <!-- PATTERN:NAV -> PENDING_REGISTRATIONS -->
                                <Button onAction="#handleBack" styleClass="secondary-button" text="‹ Back" />
                                <Region HBox.hgrow="ALWAYS" />
                                <!-- PATTERN:ACTION handleReject -->
                                <Button fx:id="rejectBtn" onAction="#handleReject" styleClass="btn-suspend-outline" text="Reject" />
                                <!-- PATTERN:ACTION handleApprove -->
                                <Button fx:id="approveBtn" onAction="#handleApprove" styleClass="primary-button" text="Approve" />
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <!-- PATTERN:DYNAMIC visibility: Modal Dialog Overlay embedded via fx:include -->
        <fx:include fx:id="dialog" managed="false" source="../shared/dialog.fxml" visible="false" />

    </children>
</StackPane>