<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- In-shell screen: header, sidebar and logout come from shared/shell.fxml -->
<ScrollPane fitToWidth="true" styleClass="dashboard-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.admin.ReportsController">
    <stylesheets>
        <URL value="@../aniplato.css" />
    </stylesheets>
    <content>

        <VBox spacing="24.0" styleClass="dashboard-bg">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
            </padding>
            <children>

                <!-- HEADER & MONTH SELECTOR -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="page-title" text="Reports" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="text-muted" text="📅 Month:" />
                                <!-- PATTERN:DYNAMIC monthComboBox : selected month -->
                                <ComboBox fx:id="monthComboBox" prefWidth="180.0" promptText="October 2026" styleClass="combo-box" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- 3x3 STAT CARDS GRID (PERFECT EQUAL-WIDTH ALIGNMENT ON RESIZE) -->
                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.333" />
                        <ColumnConstraints percentWidth="33.333" />
                        <ColumnConstraints percentWidth="33.333" />
                    </columnConstraints>
                    <children>

                        <!-- ROW 1, COL 0: KG POSTED -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-green" text="📦" />
                                        <Label styleClass="stat-card-title" text="KG POSTED" />
                                    </children>
                                </HBox>
                                <HBox alignment="BASELINE_LEFT" spacing="4.0">
                                    <children>
                                        <!-- PATTERN:DYNAMIC kgPosted : formatted number -->
                                        <Label fx:id="kgPostedLabel" styleClass="stat-value" text="18,450" />
                                        <Label styleClass="stat-unit" text="kg" />
                                    </children>
                                </HBox>
                                <Label styleClass="text-muted" text="Total kg posted" />
                            </children>
                        </VBox>

                        <!-- ROW 1, COL 1: KG RESCUED -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-green" text="🤝" />
                                        <Label styleClass="stat-card-title" text="KG RESCUED" />
                                    </children>
                                </HBox>
                                <HBox alignment="BASELINE_LEFT" spacing="4.0">
                                    <children>
                                        <!-- PATTERN:DYNAMIC kgRescued : formatted number -->
                                        <Label fx:id="kgRescuedLabel" styleClass="stat-value" text="16,230" />
                                        <Label styleClass="stat-unit" text="kg" />
                                    </children>
                                </HBox>
                                <Label styleClass="text-muted" text="Picked up and confirmed" />
                            </children>
                        </VBox>

                        <!-- ROW 1, COL 2: KG EXPIRED -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-orange" text="📅" />
                                        <Label styleClass="stat-card-title" text="KG EXPIRED" />
                                    </children>
                                </HBox>
                                <HBox alignment="BASELINE_LEFT" spacing="4.0">
                                    <children>
                                        <!-- PATTERN:DYNAMIC kgExpired : formatted number -->
                                        <Label fx:id="kgExpiredLabel" styleClass="stat-value" text="2,220" />
                                        <Label styleClass="stat-unit" text="kg" />
                                    </children>
                                </HBox>
                                <Label styleClass="text-muted" text="Passed use-by, no handoff" />
                            </children>
                        </VBox>

                        <!-- ROW 2, COL 0: RESCUE RATE -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-blue" text="📈" />
                                        <Label styleClass="stat-card-title" text="RESCUE RATE" />
                                    </children>
                                </HBox>
                                <!-- PATTERN:DYNAMIC rescueRate : percentage, one decimal -->
                                <Label fx:id="rescueRateLabel" styleClass="stat-value" text="88.0%" />
                                <Label styleClass="text-muted" text="kg rescued ÷ kg posted" />
                            </children>
                        </VBox>

                        <!-- ROW 2, COL 1: HANDOFFS COMPLETED -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-green" text="📋" />
                                        <Label styleClass="stat-card-title" text="HANDOFFS COMPLETED" />
                                    </children>
                                </HBox>
                                <!-- PATTERN:DYNAMIC handoffsCompletedCount : whole number -->
                                <Label fx:id="handoffsCompletedCountLabel" styleClass="stat-value" text="412" />
                                <Label styleClass="text-muted" text="Picked up and confirmed" />
                            </children>
                        </VBox>

                        <!-- ROW 2, COL 2: PEOPLE SERVED -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-green" text="🫂" />
                                        <Label styleClass="stat-card-title" text="PEOPLE SERVED" />
                                    </children>
                                </HBox>
                                <!-- PATTERN:DYNAMIC peopleServedCount : formatted number -->
                                <Label fx:id="peopleServedCountLabel" styleClass="stat-value" text="9,640" />
                                <Label styleClass="text-muted" text="From submitted reports" />
                            </children>
                        </VBox>

                        <!-- ROW 3, COL 0: OFFER ACCEPTANCE -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-orange" text="📅" />
                                        <Label styleClass="stat-card-title" text="OFFER ACCEPTANCE" />
                                    </children>
                                </HBox>
                                <!-- PATTERN:DYNAMIC offerAcceptanceRate : percentage, one decimal -->
                                <Label fx:id="offerAcceptanceRateLabel" styleClass="stat-value" text="82.4%" />
                                <Label styleClass="text-muted" text="Accepted ÷ listings with offers" />
                            </children>
                        </VBox>

                        <!-- ROW 3, COL 1: LAPSE RATE -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-blue" text="📉" />
                                        <Label styleClass="stat-card-title" text="LAPSE RATE" />
                                    </children>
                                </HBox>
                                <!-- PATTERN:DYNAMIC lapseRate : percentage, one decimal -->
                                <Label fx:id="lapseRateLabel" styleClass="stat-value" text="6.1%" />
                                <Label styleClass="text-muted" text="Lapsed ÷ accepted offers" />
                            </children>
                        </VBox>

                        <!-- ROW 3, COL 2: REPORT COMPLIANCE -->
                        <VBox spacing="10.0" styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="2">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="stat-icon-blue" text="📈" />
                                        <Label styleClass="stat-card-title" text="REPORT COMPLIANCE" />
                                    </children>
                                </HBox>
                                <!-- PATTERN:DYNAMIC reportComplianceRate : percentage, one decimal -->
                                <Label fx:id="reportComplianceRateLabel" styleClass="stat-value" text="91.5%" />
                                <Label styleClass="text-muted" text="Reports on time ÷ reports due" />
                            </children>
                        </VBox>

                    </children>
                </GridPane>

                <!-- BY CITY TABLE -->
                <VBox spacing="16.0" styleClass="table-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="section-title" text="By city" />

                        <VBox spacing="0.0">
                            <children>
                                <!-- HEADER ROW -->
                                <GridPane styleClass="table-header-row">
                                    <padding>
                                        <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
                                    </padding>
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="24.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                        <ColumnConstraints percentWidth="22.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label styleClass="table-header-text" text="CITY" GridPane.columnIndex="0" />
                                        <Label styleClass="table-header-text" text="KG POSTED" GridPane.columnIndex="1" />
                                        <Label styleClass="table-header-text" text="KG RESCUED" GridPane.columnIndex="2" />
                                        <Label styleClass="table-header-text" text="KG EXPIRED" GridPane.columnIndex="3" />
                                        <Label styleClass="table-header-text" text="RESCUE RATE" GridPane.columnIndex="4" />
                                    </children>
                                </GridPane>

                                <!-- PATTERN:LIST cityRowsBox -->
                                <VBox fx:id="cityRowsBox">
                                    <children>
</children>
                                </VBox>

                                <!-- SUMMARY ROW: ALL CITIES -->
                                <GridPane styleClass="table-header-row">
                                    <padding>
                                        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                                    </padding>
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="24.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                        <ColumnConstraints percentWidth="22.0" />
                                    </columnConstraints>
                                    <children>
                                        <!-- PATTERN:DYNAMIC totalCityName : "All cities" -->
                                        <Label fx:id="totalCityNameLabel" styleClass="form-label" text="All cities" GridPane.columnIndex="0" />
                                        <!-- PATTERN:DYNAMIC totalKgPosted : total kg -->
                                        <Label fx:id="totalKgPostedLabel" styleClass="form-label" text="18,450 kg" GridPane.columnIndex="1" />
                                        <!-- PATTERN:DYNAMIC totalKgRescued : total kg -->
                                        <Label fx:id="totalKgRescuedLabel" styleClass="form-label" text="16,230 kg" GridPane.columnIndex="2" />
                                        <!-- PATTERN:DYNAMIC totalKgExpired : total kg -->
                                        <Label fx:id="totalKgExpiredLabel" styleClass="form-label" text="2,220 kg" GridPane.columnIndex="3" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="4">
                                            <children>
                                                <!-- PATTERN:DYNAMIC totalRescueRate : overall percentage -->
                                                <Label fx:id="totalRescueRateLabel" styleClass="text-success-bold" text="88.0%" />
                                                <ProgressBar fx:id="totalRescueProgressBar" progress="0.88" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>

                            </children>
                        </VBox>

                    </children>
                </VBox>

                <Label styleClass="text-muted" text="Rescue rate = kg rescued ÷ kg posted, over closed posts, leaving out cancelled ones. Kg comes from the post; nothing is weighed at handoff." wrapText="true" />
            </children>
        </VBox>

    </content>
</ScrollPane>