<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- In-shell screen: header, sidebar and logout come from shell.fxml -->
<VBox spacing="20.0" styleClass="dashboard-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.admin.AdminDashboardController">
    <stylesheets>
        <URL value="@../aniplato.css" />
    </stylesheets>
    <padding>
        <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
    </padding>
    <children>

        <Label text="Dashboard" textFill="#111827">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>

        <!-- TOP METRICS CARDS ROW -->
        <HBox spacing="20.0">
            <children>
                <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER" styleClass="stat-icon-orange">
                                    <children>
                                        <Label text="👤" textFill="#D97706" />
                                    </children>
                                </HBox>
                                <Label styleClass="stat-card-title" text="PENDING ACCOUNTS" />
                            </children>
                        </HBox>
                        <!-- PATTERN:DYNAMIC pendingCount : whole number -->
                        <Label fx:id="pendingCountLabel" text="00" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                        <Label text="Awaiting admin review" textFill="#6B7280">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER" styleClass="stat-icon-green">
                                    <children>
                                        <Label text="⚖" textFill="#16A34A" />
                                    </children>
                                </HBox>
                                <Label styleClass="stat-card-title" text="KG LISTED" />
                            </children>
                        </HBox>
                        <HBox alignment="BASELINE_LEFT" spacing="4.0">
                            <children>
                                <!-- PATTERN:DYNAMIC kgListed : "48,250" (number only; "kg" is static) -->
                                <Label fx:id="kgListedLabel" text="00,000" textFill="#111827">
                                    <font>
                                        <Font name="System Bold" size="32.0" />
                                    </font>
                                </Label>
                                <Label text="kg" textFill="#4B5563">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <Label text="Total kg posted this month" textFill="#6B7280">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox spacing="12.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER" styleClass="stat-icon-blue">
                                    <children>
                                        <Label text="🛡" textFill="#2563EB" />
                                    </children>
                                </HBox>
                                <Label styleClass="stat-card-title" text="RESCUE RATE" />
                            </children>
                        </HBox>
                        <!-- PATTERN:DYNAMIC rescueRate : "94.6%" -->
                        <Label fx:id="rescueRateLabel" text="00.0%" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                        <Label text="Share of listed kg rescued" textFill="#6B7280">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- PENDING ACCOUNTS TABLE CONTAINER -->
        <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <VBox spacing="16.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Pending Accounts" textFill="#111827">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <!-- PATTERN:NAV -> PENDING_REGISTRATIONS -->
                                <Hyperlink styleClass="hyperlink, nav-pending-registrations" text="View all →">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Hyperlink>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" styleClass="table-header-row">
                            <children>
                                <Label prefWidth="250.0" styleClass="table-header-text" text="ORGANIZATION" />
                                <Label prefWidth="160.0" styleClass="table-header-text" text="ROLE" />
                                <Label prefWidth="180.0" styleClass="table-header-text" text="TYPE" />
                                <Label prefWidth="150.0" styleClass="table-header-text" text="CITY" />
                                <Label prefWidth="160.0" styleClass="table-header-text" text="REGISTERED" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <!-- PATTERN:LIST pendingRows : one row per pending registration (sample row below) -->
                        <VBox fx:id="pendingRowsBox">
                            <children>
                                <HBox alignment="CENTER_LEFT" styleClass="table-data-row">
                                    <children>
                                        <Label prefWidth="250.0" styleClass="form-label" text="Sample Community Pantry" />
                                        <HBox alignment="CENTER_LEFT" prefWidth="160.0">
                                            <children>
                                                <!-- pill class by role: pill-food-org / pill-food-donor -->
                                                <HBox alignment="CENTER" styleClass="pill-food-org">
                                                    <children>
                                                        <Label text="Food Organization" textFill="#0369A1">
                                                            <font>
                                                                <Font name="System Bold" size="11.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                        <Label prefWidth="180.0" text="Food Group / NGO" textFill="#4B5563" />
                                        <Label prefWidth="150.0" text="Sample City" textFill="#4B5563" />
                                        <Label prefWidth="160.0" text="Oct 4, 9:14 AM" textFill="#6B7280" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <!-- TODO: PATTERN:ACTION per row (opens REVIEW_REGISTRATION for this registration) -->
                                        <Button minWidth="-Infinity" styleClass="table-review-btn" text="Review ›" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </VBox>

    </children>
</VBox>
