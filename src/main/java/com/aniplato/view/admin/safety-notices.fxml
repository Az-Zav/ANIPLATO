<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- In-shell screen: header, sidebar and logout come from shared/shell.fxml -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.admin.SafetyNoticesController">
    <children>
<ScrollPane fitToWidth="true" styleClass="table-scroll">
    <stylesheets>
        <URL value="@../aniplato.css" />
    </stylesheets>
    <content>
        <VBox spacing="20.0" styleClass="dashboard-bg">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
            </padding>
            <children>

                <!-- PAGE TITLE & SUBTITLE -->
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="page-title" text="Safety Notices" />
                        <!-- PATTERN:DYNAMIC noticeSummary : summary counter string -->
                        <Label fx:id="noticeSummaryLabel" styleClass="text-muted" text="2 open · close each as dismissed, or suspend the account responsible" />
                    </children>
                </VBox>

                <!-- MAIN TABLE CARD -->
                <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <VBox spacing="16.0" VBox.vgrow="ALWAYS">
                            <children>

                                <!-- HEADER ROW -->
                                <GridPane styleClass="table-header-row">
                                    <padding>
                                        <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
                                    </padding>
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="26.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                        <ColumnConstraints percentWidth="20.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                        <ColumnConstraints percentWidth="18.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label styleClass="table-header-text" text="FLAGGED ACCOUNT" GridPane.columnIndex="0" />
                                        <Label styleClass="table-header-text" text="RAISED BY" GridPane.columnIndex="1" />
                                        <Label styleClass="table-header-text" text="LISTING" GridPane.columnIndex="2" />
                                        <Label styleClass="table-header-text" text="CONCERN" GridPane.columnIndex="3" />
                                        <Label styleClass="table-header-text" text="FLAGGED" GridPane.columnIndex="4" />
                                    </children>
                                </GridPane>

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="table-scroll" VBox.vgrow="ALWAYS">
                                    <content>
                                        <!-- PATTERN:LIST safetyNoticeRowsBox -->
                                        <VBox fx:id="safetyNoticeRowsBox">
                                            <children>
</children>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <!-- PATTERN:DYNAMIC visibility: emptyLabel shown when no safety notices exist -->
                                <Label fx:id="emptyLabel" managed="false" styleClass="text-muted" text="No safety notices flagged." visible="false" />

                            </children>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>

        <!-- Resolve notice dialog overlay -->
        <fx:include fx:id="dialog" managed="false" source="../shared/dialog.fxml" visible="false" />

    </children>
</StackPane>
