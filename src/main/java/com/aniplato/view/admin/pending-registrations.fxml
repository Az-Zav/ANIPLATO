<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- In-shell screen: header, sidebar and logout come from shared/shell.fxml -->
<ScrollPane fitToWidth="true" styleClass="table-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aniplato.controller.admin.PendingRegistrationsController">
    <stylesheets>
        <URL value="@../aniplato.css" />
    </stylesheets>
    <content>
        <VBox spacing="20.0" styleClass="dashboard-bg">
            <padding>
                <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
            </padding>
            <children>

                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="page-title" text="Pending Accounts" />
                        <!-- PATTERN:DYNAMIC summaryLabel : "{count} registrations awaiting review" -->
                        <Label fx:id="summaryLabel" styleClass="text-muted" text="14 registrations awaiting review" />
                    </children>
                </VBox>

                <!-- PENDING REGISTRATIONS TABLE CONTAINER -->
                <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <VBox spacing="16.0" VBox.vgrow="ALWAYS">
                            <children>

                                <!-- PERFECTLY ALIGNED HEADER ROW (4 COLUMNS) -->
                                <GridPane styleClass="table-header-row">
                                    <padding>
                                        <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
                                    </padding>
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="38.0" />
                                        <ColumnConstraints percentWidth="20.0" />
                                        <ColumnConstraints percentWidth="22.0" />
                                        <ColumnConstraints percentWidth="20.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label styleClass="table-header-text" text="NAME" GridPane.columnIndex="0" />
                                        <Label styleClass="table-header-text" text="ROLE" GridPane.columnIndex="1" />
                                        <Label styleClass="table-header-text" text="CITY" GridPane.columnIndex="2" />
                                        <Label styleClass="table-header-text" text="REGISTERED" GridPane.columnIndex="3" />
                                    </children>
                                </GridPane>

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="table-scroll" VBox.vgrow="ALWAYS">
                                    <content>
                                        <!-- PATTERN:LIST pendingRowsBox : one row per pending registration -->
                                        <VBox fx:id="pendingRowsBox">
                                            <children>
</children>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <!-- PATTERN:DYNAMIC visibility: emptyLabel shown when no registration is pending -->
                                <Label fx:id="emptyLabel" managed="false" styleClass="text-muted" text="No registrations awaiting review" visible="false" />

                            </children>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>